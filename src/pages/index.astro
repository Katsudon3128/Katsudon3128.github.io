---
import ArticleList from "../components/ArticleList.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { siteConfig } from "../config/site";
import { projects } from "../data/projects";
import { thoughts } from "../data/thoughts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../utils/formatDate";
import { getPublishedPosts } from "../utils/getPublishedPosts";

const featuredProjects = projects
  .filter((project) => project.featured)
  .slice(0, 3);
const recentPosts = (await getPublishedPosts()).slice(0, 3);
const latestThought = thoughts.toSorted(
  (a, b) =>
    new Date(b.publishedAt).valueOf() - new Date(a.publishedAt).valueOf(),
)[0];
---

<BaseLayout metadata={siteConfig.pages.home}>
  <Hero
    title={siteConfig.home.headline}
    introduction={siteConfig.home.introduction}
    cover={siteConfig.assets.covers.home}
  />

  <section
    class="page-section content-width"
    aria-labelledby="featured-projects-title"
  >
    <div class="section-heading">
      <h2 id="featured-projects-title">焦點專案</h2>
      <a href="/projects/">查看所有專案</a>
    </div>
    <div class="project-grid">
      {
        featuredProjects.map((project) => (
          <ProjectCard project={project} labelPrefix="焦點專案" />
        ))
      }
    </div>
  </section>

  <section
    class="page-section content-width"
    aria-labelledby="recent-posts-title"
  >
    <div class="section-heading">
      <h2 id="recent-posts-title">最近文章</h2>
      <a href="/blog/">查看所有文章</a>
    </div>
    <ArticleList posts={recentPosts} labelPrefix="最近文章" />
  </section>

  <section
    class="page-section content-width"
    aria-labelledby="latest-thought-title"
  >
    <h2 id="latest-thought-title">最新想法</h2>
    {
      latestThought && (
        <article class="thought" aria-label="最新想法">
          <time datetime={latestThought.publishedAt}>
            {formatDate(latestThought.publishedAt)}
          </time>
          <p>{latestThought.text}</p>
          {latestThought.related && (
            <a href={latestThought.related.href}>
              {latestThought.related.label}
            </a>
          )}
        </article>
      )
    }
  </section>
</BaseLayout>

<style>
  .thought {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    border: 1px solid var(--color-border);
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-surface);
  }

  .thought p {
    max-width: 42ch;
    margin-bottom: 0;
    font-size: clamp(1.4rem, 4vw, 2.6rem);
    line-height: 1.35;
  }
</style>
