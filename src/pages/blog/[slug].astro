---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/formatDate";
import { getPublishedPosts } from "../../utils/getPublishedPosts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  metadata={{ title: post.data.title, description: post.data.summary }}
>
  <article class="article-page">
    <header class="article-header content-width">
      <a class="back-link" href="/blog/">← 返回部落格</a>
      <img
        src={post.data.cover}
        alt={post.data.coverAlt}
        width="1200"
        height="600"
      />
      <div class="article-header__text">
        <ul class="tag-list" aria-label="文章標籤">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        <h1>{post.data.title}</h1>
        <p>{post.data.summary}</p>
        <time datetime={post.data.publishedAt.toISOString()}>
          發布於 {formatDate(post.data.publishedAt)}
        </time>
      </div>
    </header>
    <div class="article-body content-width">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  .article-header {
    display: grid;
    gap: 2rem;
  }

  .article-header > img {
    width: 100%;
    max-height: 32rem;
    border: 1px solid var(--color-border);
    object-fit: cover;
  }

  .article-header__text,
  .article-body {
    width: min(100%, var(--reading-width));
    margin-inline: auto;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.3rem, 7vw, 5rem);
  }

  .article-header__text > p {
    color: var(--color-text-muted);
    font-size: 1.15rem;
  }

  .article-body {
    padding-block: clamp(3rem, 8vw, 6rem);
    font-size: 1.08rem;
  }

  .article-body :global(h2) {
    margin-block: 3rem 1rem;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
  }

  .article-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .back-link {
    justify-self: start;
  }
</style>
