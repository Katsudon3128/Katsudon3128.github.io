---
import ArticleList from "../../../components/ArticleList.astro";
import CompactPageHeader from "../../../components/CompactPageHeader.astro";
import Pagination from "../../../components/Pagination.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getPageCount,
  paginatePosts,
  type BlogPost,
} from "../../../utils/blogListings";
import { getPublishedPosts } from "../../../utils/getPublishedPosts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = getPageCount(posts);

  return Array.from({ length: totalPages - 1 }, (_, index) => index + 2).map(
    (page) => ({
      params: { page: String(page) },
      props: { page, posts, totalPages },
    }),
  );
}

interface Props {
  page: number;
  posts: BlogPost[];
  totalPages: number;
}

const { page, posts, totalPages }: Props = Astro.props;
const metadata = {
  title: `部落格第 ${page} 頁`,
  description: `查理林的 Web 軟體產品文章，第 ${page} 頁。`,
};
---

<BaseLayout metadata={metadata}>
  <CompactPageHeader
    eyebrow="部落格"
    title={`所有文章・第 ${page} 頁`}
    introduction="依發布日期由新到舊，繼續瀏覽產品設計、開發與維運文章。"
  />
  <section
    class="page-section content-width"
    aria-label={`文章列表第 ${page} 頁`}
  >
    <ArticleList posts={paginatePosts(posts, page)} showCovers />
    <Pagination currentPage={page} totalPages={totalPages} basePath="/blog/" />
  </section>
</BaseLayout>
