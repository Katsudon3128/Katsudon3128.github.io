---
import ArticleList from "../../components/ArticleList.astro";
import Hero from "../../components/Hero.astro";
import Pagination from "../../components/Pagination.astro";
import { siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getBlogPosts } from "../../utils/getPublishedPosts";
import { getPageCount, paginatePosts } from "../../utils/blogListings";

const posts = await getBlogPosts({ includeDrafts: import.meta.env.DEV });
const publishedPosts = posts.filter((post) => !post.data.draft);
const visiblePosts = import.meta.env.DEV ? posts : publishedPosts;
const totalPages = getPageCount(visiblePosts);
---

<BaseLayout metadata={siteConfig.pages.blog}>
  <Hero
    eyebrow="部落格"
    title="把做產品的判斷，寫成可追溯的文章。"
    introduction="記錄 Web 軟體產品從需求、設計、實作到上線維運的具體方法。"
    cover={siteConfig.assets.covers.blog}
  />
  <section
    class="page-section content-width"
    aria-labelledby="article-list-title"
  >
    <h2 id="article-list-title">所有文章</h2>
    <ArticleList posts={paginatePosts(visiblePosts, 1)} showCovers />
    <Pagination currentPage={1} totalPages={totalPages} basePath="/blog/" />
  </section>
</BaseLayout>
