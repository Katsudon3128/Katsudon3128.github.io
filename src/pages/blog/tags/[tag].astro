---
import TagListingPage from "../../../components/TagListingPage.astro";
import {
  getPageCount,
  getTagListings,
  type BlogPost,
} from "../../../utils/blogListings";
import { getPublishedPosts } from "../../../utils/getPublishedPosts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTagListings(posts).map(({ tag, posts: taggedPosts }) => ({
    params: { tag: tag.slug },
    props: { label: tag.label, slug: tag.slug, posts: taggedPosts },
  }));
}

interface Props {
  label: string;
  slug: string;
  posts: BlogPost[];
}

const { label, slug, posts }: Props = Astro.props;
const totalPages = getPageCount(posts);
---

<TagListingPage
  label={label}
  slug={slug}
  page={1}
  posts={posts}
  totalPages={totalPages}
/>
