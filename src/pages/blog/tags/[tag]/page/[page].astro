---
import TagListingPage from "../../../../../components/TagListingPage.astro";
import {
  getPageCount,
  getTagListings,
  type BlogPost,
} from "../../../../../utils/blogListings";
import { getPublishedPosts } from "../../../../../utils/getPublishedPosts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return getTagListings(posts).flatMap(({ tag, posts: taggedPosts }) => {
    const totalPages = getPageCount(taggedPosts);
    return Array.from({ length: totalPages - 1 }, (_, index) => index + 2).map(
      (page) => ({
        params: { tag: tag.slug, page: String(page) },
        props: {
          label: tag.label,
          slug: tag.slug,
          page,
          posts: taggedPosts,
          totalPages,
        },
      }),
    );
  });
}

interface Props {
  label: string;
  slug: string;
  page: number;
  posts: BlogPost[];
  totalPages: number;
}

const { label, slug, page, posts, totalPages }: Props = Astro.props;
---

<TagListingPage
  label={label}
  slug={slug}
  page={page}
  posts={posts}
  totalPages={totalPages}
/>
