---
import type { BlogPost } from "../utils/blogListings";
import { paginatePosts } from "../utils/blogListings";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "./ArticleList.astro";
import CompactPageHeader from "./CompactPageHeader.astro";
import Pagination from "./Pagination.astro";

interface Props {
  label: string;
  slug: string;
  page: number;
  posts: BlogPost[];
  totalPages: number;
}

const { label, slug, page, posts, totalPages } = Astro.props;
const pageLabel = page === 1 ? "" : `第 ${page} 頁`;
const metadata = {
  title: `${label}文章${pageLabel}`,
  description: `瀏覽查理林以「${label}」標記的文章${page === 1 ? "" : `，第 ${page} 頁`}。`,
};
---

<BaseLayout metadata={metadata}>
  <CompactPageHeader
    eyebrow="文章標籤"
    title={page === 1 ? label : `${label}・第 ${page} 頁`}
    introduction={`共 ${posts.length} 篇文章，依發布日期由新到舊排列。`}
  />
  <section
    class="page-section content-width"
    aria-label={`${label}文章列表${pageLabel}`}
  >
    <ArticleList posts={paginatePosts(posts, page)} showCovers />
    <Pagination
      currentPage={page}
      totalPages={totalPages}
      basePath={`/blog/tags/${slug}/`}
    />
  </section>
</BaseLayout>
