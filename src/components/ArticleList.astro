---
import type { CollectionEntry } from "astro:content";
import { buildResponsiveArticleImage } from "../utils/articleImages";
import { formatDate } from "../utils/formatDate";
import ArticleTags from "./ArticleTags.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  showCovers?: boolean;
  labelPrefix?: string;
}

const { posts, showCovers = false, labelPrefix } = Astro.props;
const thumbnailSizes =
  "(max-width: 44.99rem) calc(100vw - 2rem), (max-width: 79rem) 30vw, 22rem";
const rows = await Promise.all(
  posts.map(async (post) => ({
    post,
    coverImage: showCovers
      ? await buildResponsiveArticleImage(post.data.cover, thumbnailSizes)
      : undefined,
  })),
);
---

<div class="article-list">
  {
    rows.map(({ post, coverImage }) => (
      <article
        class:list={["article-row", { "article-row--with-cover": showCovers }]}
        aria-label={`${labelPrefix ?? "文章摘要"}：${post.data.title}`}
      >
        {coverImage && (
          <img
            src={coverImage.src}
            alt={post.data.coverAlt}
            width={coverImage.width}
            height={coverImage.height}
            loading="lazy"
            decoding="async"
            srcset={coverImage.srcset}
            sizes={coverImage.sizes}
          />
        )}
        <time datetime={post.data.publishedAt.toISOString()}>
          {formatDate(post.data.publishedAt)}
        </time>
        <div>
          <h3>
            <a href={`/blog/${post.data.slug}/`}>{post.data.title}</a>
            {post.data.draft && <span class="draft-label">草稿</span>}
          </h3>
          <p>{post.data.summary}</p>
          <ArticleTags tags={post.data.tags} />
        </div>
      </article>
    ))
  }
</div>

<style>
  .article-list {
    margin-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .article-row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-row--with-cover {
    grid-template-columns: minmax(12rem, 22rem) minmax(0, 7rem) minmax(0, 1fr);
  }

  h3 {
    margin-bottom: 0.75rem;
  }

  .draft-label {
    margin-inline-start: 0.6rem;
    border: 1px solid var(--color-accent);
    padding: 0.1rem 0.35rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    vertical-align: middle;
  }

  p {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }

  img {
    width: 100%;
    height: 100%;
    max-height: 13rem;
    border: 1px solid var(--color-border);
    object-fit: cover;
  }

  @media (max-width: 44.99rem) {
    .article-row,
    .article-row--with-cover {
      grid-template-columns: minmax(0, 1fr);
    }

    img {
      max-height: none;
    }
  }
</style>
