---
import type { CoverConfig } from "../config/site";

interface Props {
  eyebrow?: string;
  title: string;
  introduction?: string;
  cover: CoverConfig;
}

const { eyebrow, title, introduction, cover } = Astro.props;
const style = `--cover-position: ${cover.position}; --overlay-opacity: ${cover.overlay};`;
---

<section class="full-bleed-hero" style={style} aria-labelledby="page-title">
  <img
    data-full-bleed-cover
    class="full-bleed-hero__image"
    src={cover.src}
    alt={cover.alt}
    width="1600"
    height="1000"
    fetchpriority="high"
  />
  <div class="full-bleed-hero__overlay"></div>
  <div class="full-bleed-hero__content content-width">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 id="page-title">{title}</h1>
    {introduction && <p class="hero-introduction">{introduction}</p>}
  </div>
</section>

<style>
  .full-bleed-hero {
    position: relative;
    display: grid;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    isolation: isolate;
  }

  .full-bleed-hero__image,
  .full-bleed-hero__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .full-bleed-hero__image {
    object-fit: cover;
    object-position: var(--cover-position);
  }

  .full-bleed-hero__overlay {
    z-index: -1;
    background: rgb(10 9 8 / var(--overlay-opacity));
  }

  .full-bleed-hero__content {
    align-self: end;
    padding-block: clamp(5rem, 15vh, 10rem) clamp(3rem, 9vh, 6rem);
  }

  h1 {
    max-width: 12ch;
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-introduction {
    max-width: 46rem;
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }
</style>
