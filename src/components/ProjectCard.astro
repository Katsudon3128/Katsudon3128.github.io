---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  labelPrefix?: string;
}

const { project, labelPrefix = "專案" } = Astro.props;
---

<article class="project-card" aria-label={`${labelPrefix}：${project.name}`}>
  <img
    src={project.image}
    alt={project.imageAlt}
    width="720"
    height="440"
    loading="lazy"
  />
  <div class="project-card__body">
    <div class="project-card__heading">
      <h3>{project.name}</h3>
      <span class="status">{project.status}</span>
    </div>
    <p>{project.summary}</p>
    <ul class="tag-list" aria-label="使用技術">
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <a href={project.githubUrl} target="_blank" rel="noreferrer">
      前往 GitHub <span aria-hidden="true">↗</span><span class="visually-hidden"
        >（在新分頁開啟）</span
      >
    </a>
  </div>
</article>

<style>
  .project-card {
    min-width: 0;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .project-card > img {
    width: 100%;
    aspect-ratio: 18 / 11;
    border-bottom: 1px solid var(--color-border);
    object-fit: cover;
  }

  .project-card__body {
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .project-card__heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    margin-bottom: 0.75rem;
  }

  p {
    color: var(--color-text-muted);
  }

  .status {
    flex: 0 0 auto;
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.45rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
</style>
