---
import { getBlogTag } from "../config/blogTags";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="tag-list" aria-label="文章標籤">
  {
    tags.map((tag) => {
      const tagDefinition = getBlogTag(tag);
      return (
        tagDefinition && (
          <li>
            <a href={`/blog/tags/${tagDefinition.slug}/`}>{tag}</a>
          </li>
        )
      );
    })
  }
</ul>

<style>
  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text);
  }
</style>
