---
import { siteConfig } from "../config/site";
---

<header class="site-header">
  <a class="skip-link" href="#main-content">跳到主要內容</a>
  <div class="site-header__inner">
    <a class="site-logo" aria-label="回到首頁" href="/">
      <img src={siteConfig.assets.logo} width="42" height="42" alt="" />
    </a>
    <nav aria-label="主要導覽">
      <ul class="site-nav">
        {
          siteConfig.navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  Astro.url.pathname === item.href ? "page" : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .skip-link {
    position: fixed;
    z-index: 20;
    inset: 0 auto auto 0;
    padding: 0.75rem 1rem;
    translate: 0 -120%;
    background: var(--color-accent);
    color: var(--color-background);
  }

  .skip-link:focus {
    translate: 0;
  }

  .site-header {
    position: sticky;
    z-index: 10;
    top: 0;
    min-height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: min(100% - 1.25rem, var(--content-width));
    min-height: var(--header-height);
    margin-inline: auto;
  }

  .site-logo {
    flex: 0 0 auto;
    border: 1px solid var(--color-border);
  }

  .site-logo img {
    width: 2.625rem;
    height: 2.625rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.1rem, 1vw, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: block;
    padding: 0.45rem clamp(0.3rem, 1vw, 0.7rem);
    color: var(--color-text-muted);
    font-size: clamp(0.78rem, 2.8vw, 0.95rem);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--color-text);
    box-shadow: inset 0 -2px var(--color-accent);
  }
</style>
