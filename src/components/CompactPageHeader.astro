---
interface Props {
  eyebrow: string;
  title: string;
  introduction: string;
}

const { eyebrow, title, introduction } = Astro.props;
---

<header class="compact-page-header content-width">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{introduction}</p>
</header>

<style>
  .compact-page-header {
    padding-block: clamp(4rem, 10vw, 7rem);
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
  }

  h1 {
    max-width: 14ch;
    margin-bottom: 1rem;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
  }

  header > p:last-child {
    max-width: 46rem;
    margin-bottom: 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }
</style>
